{
  "displayName": "kalshiflow",
  "mosaicLayout": {
    "columns": 16,
    "tiles": [
      {
        "width": 16,
        "height": 2,
        "widget": {
          "title": "WS source",
          "text": {
            "content": "Kalshi WebSocket connection + raw frame intake.",
            "format": "MARKDOWN",
            "style": {}
          }
        }
      },
      {
        "yPos": 2,
        "width": 16,
        "height": 6,
        "widget": {
          "title": "ws_messages_received rate (per series×stream)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/ws_messages_received_total\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"series\"",
                        "metric.label.\"stream\""
                      ]
                    }
                  }
                },
                "plotType": "STACKED_AREA",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "yPos": 8,
        "width": 8,
        "height": 6,
        "widget": {
          "title": "ws_reconnects + watchdog force-reconnects rate",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/ws_reconnects_total\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                },
                "plotType": "LINE",
                "legendTemplate": "ws_reconnects (all causes)",
                "targetAxis": "Y1"
              },
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/ws_watchdog_force_reconnects_total\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                },
                "plotType": "LINE",
                "legendTemplate": "watchdog force-reconnects",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 8,
        "width": 8,
        "height": 6,
        "widget": {
          "title": "ws_connection_age",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/ws_connection_age_seconds\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN"
                    }
                  }
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "yPos": 14,
        "width": 16,
        "height": 6,
        "widget": {
          "title": "ws data-stall force-reconnects rate",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/ws_data_stall_force_reconnects_total\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"trigger\""
                      ]
                    }
                  }
                },
                "plotType": "LINE",
                "legendTemplate": "trigger=${metric.label.trigger}",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "reconnects/sec",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 20,
        "width": 16,
        "height": 6,
        "widget": {
          "title": "ws_backoff_attempt_current",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/ws_backoff_attempt_current\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MAX",
                      "crossSeriesReducer": "REDUCE_MAX"
                    }
                  }
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "attempt",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 26,
        "width": 16,
        "height": 2,
        "widget": {
          "title": "Pub/Sub publish",
          "text": {
            "content": "Publish-side latency + failures (worker → kalshi.* topics).",
            "format": "MARKDOWN",
            "style": {}
          }
        }
      },
      {
        "yPos": 28,
        "width": 8,
        "height": 6,
        "widget": {
          "title": "pubsub_publish_latency p50/p95/p99 by stream",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/pubsub_publish_latency_ms\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_50",
                      "groupByFields": [
                        "metric.label.\"stream\""
                      ]
                    }
                  }
                },
                "plotType": "LINE",
                "legendTemplate": "p50 ${metric.label.stream}",
                "targetAxis": "Y1"
              },
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/pubsub_publish_latency_ms\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                      "groupByFields": [
                        "metric.label.\"stream\""
                      ]
                    }
                  }
                },
                "plotType": "LINE",
                "legendTemplate": "p95 ${metric.label.stream}",
                "targetAxis": "Y1"
              },
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/pubsub_publish_latency_ms\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_99",
                      "groupByFields": [
                        "metric.label.\"stream\""
                      ]
                    }
                  }
                },
                "plotType": "LINE",
                "legendTemplate": "p99 ${metric.label.stream}",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 28,
        "width": 8,
        "height": 6,
        "widget": {
          "title": "pubsub_publish_failures rate",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/pubsub_publish_failures_total\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"stream\""
                      ]
                    }
                  }
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "yPos": 34,
        "width": 16,
        "height": 2,
        "widget": {
          "title": "Pub/Sub → BQ ingest",
          "text": {
            "content": "Subscription backlog age and unacked count (BQ-direct subscriptions).",
            "format": "MARKDOWN",
            "style": {}
          }
        }
      },
      {
        "yPos": 36,
        "width": 8,
        "height": 6,
        "widget": {
          "title": "subscription oldest_unacked_message_age",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"pubsub.googleapis.com/subscription/oldest_unacked_message_age\" AND resource.type=\"pubsub_subscription\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MAX",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "groupByFields": [
                        "resource.label.\"subscription_id\""
                      ]
                    }
                  }
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 36,
        "width": 8,
        "height": 6,
        "widget": {
          "title": "subscription num_undelivered_messages",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"pubsub.googleapis.com/subscription/num_undelivered_messages\" AND resource.type=\"pubsub_subscription\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "resource.label.\"subscription_id\""
                      ]
                    }
                  }
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "yPos": 42,
        "width": 16,
        "height": 2,
        "widget": {
          "title": "BQ tables",
          "text": {
            "content": "Storage uploaded row count by table.",
            "format": "MARKDOWN",
            "style": {}
          }
        }
      },
      {
        "yPos": 44,
        "width": 16,
        "height": 6,
        "widget": {
          "title": "bq uploaded_row_count by table",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"bigquery.googleapis.com/storage/uploaded_row_count\" AND resource.type=\"bigquery_dataset\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"table\""
                      ]
                    }
                  }
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "yPos": 50,
        "width": 16,
        "height": 2,
        "widget": {
          "title": "Cold tier (parquet exporter)",
          "text": {
            "content": "Daily BQ → GCS Parquet export status, runtime, and per-series row counts.",
            "format": "MARKDOWN",
            "style": {}
          }
        }
      },
      {
        "yPos": 52,
        "width": 8,
        "height": 6,
        "widget": {
          "title": "Cloud Run Job completed_executions by status",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/job/completed_execution_count\" AND resource.type=\"cloud_run_job\" AND resource.label.\"job_name\"=\"parquet-exporter\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"result\""
                      ]
                    }
                  }
                },
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 52,
        "width": 8,
        "height": 6,
        "widget": {
          "title": "parquet_run_duration_seconds (last)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/parquet_run_duration_seconds\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_50",
                      "groupByFields": [
                        "metric.label.\"outcome\""
                      ]
                    }
                  }
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "yPos": 58,
        "width": 8,
        "height": 6,
        "widget": {
          "title": "parquet_rows_exported per run by stream × series",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/parquet_rows_exported_total\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"stream\"",
                        "metric.label.\"series\""
                      ]
                    }
                  }
                },
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 58,
        "width": 8,
        "height": 6,
        "widget": {
          "title": "parquet_run_outcome (ok vs error)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/parquet_run_outcome_total\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"outcome\""
                      ]
                    }
                  }
                },
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "yPos": 64,
        "width": 16,
        "height": 2,
        "widget": {
          "title": "Worker health",
          "text": {
            "content": "Bookkeeper / discovery state and Cloud Run container utilization.",
            "format": "MARKDOWN",
            "style": {}
          }
        }
      },
      {
        "yPos": 66,
        "width": 8,
        "height": 6,
        "widget": {
          "title": "bookkeeper_registry_size",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/bookkeeper_registry_size\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_MEAN"
                    }
                  }
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 66,
        "width": 8,
        "height": 6,
        "widget": {
          "title": "subscription_roster_size",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/subscription_roster_size\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_MEAN"
                    }
                  }
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "yPos": 72,
        "width": 8,
        "height": 6,
        "widget": {
          "title": "discovery_sweep_runs by series×outcome",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/discovery_sweep_runs_total\" AND resource.type=\"generic_node\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"series\"",
                        "metric.label.\"outcome\""
                      ]
                    }
                  }
                },
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 72,
        "width": 8,
        "height": 6,
        "widget": {
          "title": "ws-worker pool — container CPU & memory util (by container)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/container/cpu/utilizations\" AND resource.type=\"cloud_run_worker_pool\" AND resource.label.\"worker_pool_name\"=\"ws-worker\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_99",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "groupByFields": ["resource.label.\"container_name\""]
                    }
                  }
                },
                "plotType": "LINE",
                "legendTemplate": "cpu p99 ${resource.label.container_name}",
                "targetAxis": "Y1"
              },
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/container/memory/utilizations\" AND resource.type=\"cloud_run_worker_pool\" AND resource.label.\"worker_pool_name\"=\"ws-worker\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_99",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "groupByFields": ["resource.label.\"container_name\""]
                    }
                  }
                },
                "plotType": "LINE",
                "legendTemplate": "mem p99 ${resource.label.container_name}",
                "targetAxis": "Y1"
              }
            ]
          }
        }
      }
    ]
  }
}
